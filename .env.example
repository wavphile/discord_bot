DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_APPLICATION_ID=replace-with-your-application-id
DISCORD_DEV_GUILD_ID=replace-with-your-test-server-id
# Comma-separated Discord user and/or role IDs allowed to use bot commands.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=
# Separate approval authority; approvers still cannot approve their own plans.
DISCORD_APPROVER_USER_IDS=
DISCORD_APPROVER_ROLE_IDS=
# Leave privileged Gateway intents off until a feature requires them.
DISCORD_ENABLE_GUILD_MEMBERS_INTENT=false
# Message retrieval also requires a server-admin opt-in and allowed channel.
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=false
DATABASE_PATH=./data/discord-bot.sqlite
# AI is disabled by default via the deterministic mock; no hosted API call is made.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1024
AI_DAILY_TOKEN_BUDGET_PER_GUILD=100000
NODE_ENV=development
